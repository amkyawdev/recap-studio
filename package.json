{
  "name": "movie-recap-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Hyper-modern, mobile-first Video Recap Studio — BYOK AI pipeline, client-side FFmpeg rendering, and a Vercel-grade dark interface.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "relay:dev": "wrangler dev --config cloudflare-worker/wrangler.toml",
    "relay:deploy": "wrangler deploy --config cloudflare-worker/wrangler.toml"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "clsx": "^2.1.1",
    "firebase": "^10.12.5",
    "framer-motion": "^11.3.24",
    "geist": "^1.3.1",
    "lucide-react": "^0.427.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
